/* ============================================================================
   SECTION — COREVEX THEME TOKENS (sleek, professional, Chrome se alag)
   bg-main #0B0C0F | bg-sidebar #14161B | elevated #1B1E24 | border #2A2D35
   accent #FF5A1F | accent2 #F02D24 | text #F4F4F5 | secondary #A1A1AA
   Gradients sirf logo / active tab / primary button par, har jagah nahi.
   Naye pages (Bookmarks/History/Downloads/ADS Lab) ke liye QListWidget
   aur QPlainTextEdit ke rules neeche add kiye gaye hain, taaki wo bhi
   isi theme me dikhen, default white na hon.
   ============================================================================ */
* { outline: none; font-family: "Segoe UI", sans-serif; font-size: 13px; }
QMainWindow, QWidget#CentralWidget { background-color: #0B0C0F; color: #F4F4F5; }
#LeftSidebar { background-color: #14161B; border-right: 1px solid #2A2D35; min-width: 200px; max-width: 200px; }
#BrandHeader { padding: 16px; border-bottom: 1px solid #2A2D35; }
#BrandTitle { color: #F4F4F5; font-size: 16px; font-weight: 800; letter-spacing: 1px; }
#BrandTagline { color: #FF5A1F; font-size: 11px; font-weight: 600; }
#NavButton { background: transparent; border: none; border-radius: 6px; color: #A1A1AA; text-align: left; padding: 10px 14px; margin: 2px 10px; }
#NavButton:hover { background-color: #1B1E24; color: #F4F4F5; }
#NavButton[active="true"] { background-color: rgba(255, 90, 31, 0.15); color: #FF5A1F; border-left: 3px solid #FF5A1F; }
#TopChrome { background-color: #0B0C0F; border-bottom: 1px solid #2A2D35; min-height: 48px; max-height: 48px; }
#IconButton { background-color: #14161B; border: 1px solid #2A2D35; border-radius: 6px; color: #A1A1AA; min-width: 32px; min-height: 32px; font-weight: bold; }
#IconButton:hover { background-color: #1B1E24; color: #F4F4F5; border-color: #FF5A1F; }
#AddressBar { background-color: #14161B; border: 1px solid #2A2D35; border-radius: 8px; padding: 6px 14px; color: #F4F4F5; selection-background-color: #FF5A1F; }
#AddressBar:focus { border: 1px solid #FF5A1F; }
#AiToggle { background-color: rgba(255, 90, 31, 0.15); border: 1px solid #FF5A1F; border-radius: 8px; color: #FF5A1F; padding: 6px 14px; font-weight: 700; }
#AiToggle:hover { background-color: #FF5A1F; color: #0B0C0F; }
QTabWidget::pane { border: none; background: #0B0C0F; }
QTabBar::tab { background: #14161B; color: #A1A1AA; border: 1px solid #2A2D35; border-bottom: none; border-top-left-radius: 8px; border-top-right-radius: 8px; min-width: 140px; padding: 8px 12px; margin-right: 4px; }
QTabBar::tab:selected { background: #1B1E24; color: #F4F4F5; border-top: 2px solid #FF5A1F; }
#AiSidebar { background-color: #14161B; border-left: 1px solid #2A2D35; min-width: 340px; max-width: 420px; }
#AiHeader { padding: 14px; border-bottom: 1px solid #2A2D35; }
#AiTitle { color: #F4F4F5; font-size: 14px; font-weight: 700; }
#AiBadge { background-color: rgba(255,90,31,0.2); color: #FF5A1F; border: 1px solid #FF5A1F; border-radius: 4px; padding: 2px 6px; font-size: 10px; font-weight: 700; }
#AgentCard { background-color: #1B1E24; border: 1px solid #2A2D35; border-radius: 8px; padding: 12px; }
#ChatInput { background-color: #1B1E24; border: 1px solid #2A2D35; border-radius: 8px; padding: 10px; color: #F4F4F5; }
#ChatInput:focus { border-color: #FF5A1F; }
#SendButton { background-color: #FF5A1F; border: none; border-radius: 8px; color: #0B0C0F; font-weight: 800; min-width: 36px; min-height: 36px; }
#ChipButton { background-color: #1B1E24; border: 1px solid #2A2D35; border-radius: 6px; color: #A1A1AA; padding: 6px 10px; font-size: 11px; }
#ChipButton:hover { border-color: #FF5A1F; color: #F4F4F5; }
QListWidget { background-color: #14161B; border: 1px solid #2A2D35; border-radius: 8px; color: #F4F4F5; }
QListWidget::item { padding: 8px; border-bottom: 1px solid #2A2D35; }
QListWidget::item:selected { background-color: #1B1E24; color: #FF5A1F; }
QPlainTextEdit { background-color: #14161B; border: 1px solid #2A2D35; border-radius: 8px; color: #F4F4F5; }
QScrollArea { background-color: transparent; border: none; }
/* --- v4.0 POLISH: sidebar wider, pill address, tooltips, menus, progress --- */
#LeftSidebar { min-width: 220px; max-width: 220px; }
#NavButton { border-radius: 8px; padding: 11px 14px; font-size: 13px; }
#NavButton[active="true"] { background-color: rgba(255, 90, 31, 0.18); font-weight: 700; }
#AddressBar { border-radius: 20px; padding: 8px 16px; }
QTabBar::tab:hover { background: #1B1E24; color: #F4F4F5; }
QToolTip { background-color: #1B1E24; color: #F4F4F5; border: 1px solid #FF5A1F; padding: 6px 10px; border-radius: 6px; }
QMenu { background-color: #14161B; color: #F4F4F5; border: 1px solid #2A2D35; padding: 6px; }
QMenu::item:selected { background-color: rgba(255, 90, 31, 0.18); color: #FFFFFF; }
QMessageBox { background-color: #0B0C0F; }
QProgressBar { background-color: #14161B; border: 1px solid #2A2D35; border-radius: 6px; color: #F4F4F5; text-align: center; }
QProgressBar::chunk { background-color: #FF5A1F; border-radius: 6px; }
QScrollBar:horizontal { background: #0B0C0F; height: 12px; }
QScrollBar::handle:horizontal { background: #2A2D35; border-radius: 6px; min-width: 20px; }
QScrollBar::handle:horizontal:hover { background: #FF5A1F; }
QCheckBox { color: #F4F4F5; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #2A2D35; border-radius: 4px; background: #14161B; }
QCheckBox::indicator:checked { background: #FF5A1F; border-color: #FF5A1F; }
QComboBox::down-arrow { border: none; }
QComboBox QAbstractItemView { background-color: #14161B; color: #F4F4F5; selection-background-color: #FF5A1F; border: 1px solid #2A2D35; }
/* --- Global sleek controls (Pages/Dialogs ke liye, jo pehle default grey the) --- */
QWidget { background-color: #0B0C0F; color: #F4F4F5; }
QPushButton { background-color: #1B1E24; border: 1px solid #2A2D35; border-radius: 8px; color: #F4F4F5; padding: 8px 16px; }
QPushButton:hover { border-color: #FF5A1F; color: #FFFFFF; }
QPushButton:pressed { background-color: #2A2D35; }
QPushButton:disabled { color: #666666; border-color: #2A2D35; }
QLineEdit, QComboBox { background-color: #14161B; border: 1px solid #2A2D35; border-radius: 8px; padding: 8px 12px; color: #F4F4F5; selection-background-color: #FF5A1F; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #FF5A1F; }
QComboBox::drop-down { border: none; }
QLabel { color: #F4F4F5; }
QDialog { background-color: #0B0C0F; color: #F4F4F5; }
QScrollBar:vertical { background: #0B0C0F; width: 12px; }
QScrollBar::handle:vertical { background: #2A2D35; border-radius: 6px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #FF5A1F; }
